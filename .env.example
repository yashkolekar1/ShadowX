# MongoDB Connection (default localhost)
MONGO_URI=mongodb://localhost:27017/
DB_NAME=shadowx_db

# Google OAuth 2.0 Client Credentials
# Get these from Google Cloud Console (https://console.cloud.google.com)
# 1. Create a project or select existing
# 2. Enable the Google+ API
# 3. Go to Credentials → Create Credentials → OAuth Client ID
# 4. Choose Web Application type
# 5. Add http://localhost:8000/callback to Authorized redirect URIs
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/callback

# Google Gemini API Key
# Get from: https://makersuite.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Flask Secret Key (generate a random one for production)
# You can generate one with: python -c "import secrets; print(secrets.token_hex(16))"
FLASK_SECRET_KEY=generate_a_secure_random_key_here